            Method (_REG, 2, NotSerialized)  // _REG: Region Availability
            {
                If (((Arg0 == 0x03) && (Arg1 == One)))
                {
                    ECON = One
                    If ((OSYS == 0x07DF))
                    {
                        OSEC = 0x07
                        P8XH (Zero, 0x07)
                    }
                    ElseIf (((OSYS == 0x07DC) || (OSYS == 0x07DD)))
                    {
                        OSEC = 0x06
                        P8XH (Zero, 0x06)
                    }
                    Else
                    {
                        OSEC = 0x05
                        P8XH (Zero, 0x05)
                    }

