                                }
                                ElseIf ((WRTO == 0x02))
                                {
                                    ADBG ("WWAN Power _DSM D3/L1.2")
                                }
                                ElseIf ((WRTO == 0x03))
                                {
                                    ADBG ("WWAN Power _DSM D3/L2")
                                }
