                CreateWordField (RBUF, \_SB.CWDT._CRS._Y4A._MIN, OMIN)  // _MIN: Minimum Base Address
                CreateWordField (RBUF, \_SB.CWDT._CRS._Y4A._MAX, OMAX)  // _MAX: Maximum Base Address
                OMIN = (PMBS + 0x54)
                OMAX = (PMBS + 0x54)
