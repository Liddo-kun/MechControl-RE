            Mutex (ECMT, 0x00)
            Method (ECMD, 1, Serialized)
            {
                If ((Acquire (ECMT, 0x01F4) == Zero))
                {
                    If (ECON)
                    {
                        While ((CMD6 & 0x02))
                        {
                            Stall (0x05)
                        }

