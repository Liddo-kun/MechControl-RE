                {
                    If ((^^^^PGPI.GGOV (PRST) != WPRP))
                    {
                        DL23 ()
                        ADBG ("WWAN DL23() Done")
                        ^^^^PGPI.SGOV (PRST, WPRP)
                        ADBG ("WWAN PERST:0 Done")
