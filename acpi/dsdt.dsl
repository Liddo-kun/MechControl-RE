                    ) == 0x000B0650)))
                {
                    Return ("INTC109F")
                }
                ElseIf ((((CPID & 0x0FFF0FF0) == 0x000C0660) || ((CPID & 
                    0x0FFF0FF0) == 0x000C06A0)))
