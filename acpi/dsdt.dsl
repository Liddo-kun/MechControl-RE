                        ^^^^PGPI.SGOV (WBRS, PBRS)
                        Sleep (0xC8)
                        Notify (PXSX, One) // Device Check
                        ^^^^PGPI.SGOV (PRST, (~WPRP & One))
                        ^^^^PGPI.SGOV (WBRS, (~PBRS & One))
                        Sleep (0xC8)
                        Local0 = Zero
                        While ((LASX == Zero))
