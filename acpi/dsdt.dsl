                                PDRC = One
                                Sleep (VDEL)
                                ^^^^^PGPI.SGOV (WLRT, Zero)
                                Sleep (PDEL)
                                ^^^^^PGPI.SGOV (WLRT, One)
                                If ((BOFC == One))
                                {
                                    If ((BRMT == Zero))
                                    {
                                        BTRK (One)
                                    }
                                    ElseIf ((WVHO != Zero))
                                    {
